# SOLVANTA backend - environment template.
#
#   1. Copy this file to   .env   (same folder)
#   2. Paste your Supabase connection string into POSTGRES_DSN
#   3. Start the server with      run-dev.cmd
#
# `.env` is listed in .gitignore: it holds a database password, never commit it.
#
# Format: KEY=value. Quotes are optional. A line starting with # is a comment.

# --- Database ---------------------------------------------------------------
# Leave EMPTY to run on the in-memory store (dev default: every restart throws
# the data away). Fill it in to persist in PostgreSQL.
#
# Supabase: copy the "Session pooler" connection string from
#   Dashboard -> Project Settings -> Database  ->  Connection string -> URI
# It looks like:
#
#   postgres://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
#   * Use port 6543 (pooler), not 5432 (direct). The pooler is what a
#     long-lived server should talk to; 5432 is meant for migrations and
#     one-off tooling and is easier to exhaust.
#   * sslmode=require is mandatory - the pooler refuses sslmode=disable.
#   * If the server boots but the first query fails with a "prepared
#     statement" error, your pooler is in Transaction mode. Switch it to
#     Session mode in the same dashboard panel: pgx prepares statements by
#     default and Transaction mode cannot hold them open.
#   * Set this before the first run - the schema in backend/migrations is
#     applied automatically at boot (all statements are IF NOT EXISTS).
POSTGRES_DSN=

# --- Server -----------------------------------------------------------------
# Listen port. `ADDR` overrides this when set.
PORT=8080

# development | production.
# production additionally REQUIRES SECRET and enables the strict defaults.
ENV=development

# Token-signing key for JWTs and refresh tokens. Required when ENV=production.
# run-dev.cmd generates one on first run and keeps it in .env, so the token an
# app has stored stays valid across restarts. Leave empty to let it do that.
SECRET=

# Seed the demo dataset.
#   development: on unless explicitly false / 0 / no
#   production:  OFF unless explicitly true / 1 / yes - so a production box
#                with POSTGRES_DSN set cannot silently grow a super-admin.
SEED=

# Comma-separated browser origins allowed by CORS. Empty = same-origin only.
# The Flutter web client is served from a different port than the API, so local
# web development needs its origin listed, e.g. (`flutter run -d web-server
# --web-port 8081` / Chrome):
#   ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ALLOWED_ORIGINS=

# IPs or CIDR ranges of a reverse proxy in front of the API, comma-separated.
# Leave EMPTY when clients connect directly (local development).
TRUSTED_PROXIES=

# --- OCR engines (optional) ---------------------------------------------------
# Empty = the mock engine, so everything runs without paid keys. The server
# prints which engine serves each route at boot. See backend/README.md
# ("OCR providers") for the privacy settings before adding real keys.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
GOOGLE_VISION_API_KEY=

# --- SMS to parents (optional) -----------------------------------------------
# Report-card-ready, absence, meeting and fee-reminder texts. Without a
# provider the server only LOGS what it would have sent (costs nothing). Each
# school still turns the individual events on inside the app.
#   SMS_PROVIDER=arkesel  needs ARKESEL_API_KEY
#   SMS_PROVIDER=hubtel   needs HUBTEL_CLIENT_ID and HUBTEL_CLIENT_SECRET
# SMS_SENDER_ID is the name parents see (must be registered with the provider;
# defaults to "SOLVANTA").
SMS_PROVIDER=
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=

# --- Transactional email (optional) ------------------------------------------
# Password-reset and notice emails. With SMTP_HOST empty the server uses the
# "log" sender: nothing is delivered, the message is only recorded. Set
# SMTP_HOST to enable real delivery.
#   SMTP_PORT defaults to 587. EMAIL_FROM defaults to
#   "SOLVANTA <no-reply@solvanta.app>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Push notifications (optional) -------------------------------------------
# Firebase Cloud Messaging server key for native push. Empty = the in-app
# notification feed is the only delivery (no external push sent).
FCM_SERVER_KEY=

# --- Metrics (optional) ------------------------------------------------------
# When set, the /metrics endpoint requires  Authorization: Bearer <token>.
# Leave empty to expose /metrics unauthenticated (fine for local dev; set it
# in production or keep /metrics off the public network).
METRICS_TOKEN=

# Gin's HTTP log/mode. Left empty, production automatically runs in release
# mode (quiet). Set to `debug` to force route logging. Rarely needed.
GIN_MODE=

# Optional. PostgreSQL integration tests in `go test ./...` SKIP while unset.
# Point it at a throwaway database, not your real one.
TEST_POSTGRES_DSN=
