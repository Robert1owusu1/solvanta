<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted ONLY for the local development API reached through
  `adb reverse tcp:8080 tcp:8080` (http://127.0.0.1:8080). Everything else
  keeps the platform default (no cleartext), so production traffic stays
  HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>