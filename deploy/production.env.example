# SOLVANTA API - production environment template.
#
# Copy to your host's secret/environment settings. Never commit the filled-in
# copy: .gitignore ignores .env and .env.* but not files with other names.
# See docs/DEPLOYMENT.md for the full checklist.

# --- Required ---------------------------------------------------------------
ENV=production

# Long random token-signing key. Generate one with:  openssl rand -hex 32
# Changing it later signs everyone out.
SECRET=

# PostgreSQL connection string — required: the server refuses to start in
# production without it. Each school gets its own schema (school_<id>); the
# files in backend/migrations are applied once per school schema and recorded
# in its schema_migrations table.
POSTGRES_DSN=

# The web app's address(es), comma-separated, exactly as the browser shows
# them (scheme + host, no trailing slash), e.g. https://portal.yourschool.com
ALLOWED_ORIGINS=

# Listen on all interfaces inside a container or behind a proxy. The default
# is loopback only (127.0.0.1:8080).
ADDR=:8080

# --- Usually needed behind a host's proxy / load balancer ---------------------
# The proxy's IP(s) or CIDR range(s). Without this every visitor appears to
# come from the proxy, and the login throttle (10 failed sign-ins a minute per
# IP) would treat the whole school as one client. Your host documents the
# range; leave empty only if clients connect to the API directly.
TRUSTED_PROXIES=

# --- Leave unset in production -----------------------------------------------
# SEED creates demo accounts with publicly known passwords. Off in production
# unless set; keep it that way.
# SEED=
# Never point TEST_POSTGRES_DSN at production: the tests empty every table.
# TEST_POSTGRES_DSN=

# --- Optional: OCR engines ----------------------------------------------------
# Unset = the mock engine (the server says which at boot). Read the privacy
# notes in backend/README.md before adding real keys.
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# GOOGLE_VISION_API_KEY=
